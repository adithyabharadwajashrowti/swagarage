# Copy to .env.local and fill in from Supabase > Project Settings > API.
# Only the PUBLIC anon key belongs here. Never put the service_role key in
# any VITE_ variable: everything prefixed VITE_ is shipped to browsers.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Cloudflare Turnstile site key (bot protection on sign-up/sign-in/reset).
# Also add the secret in Supabase > Authentication > Bot and Abuse Protection.
VITE_TURNSTILE_SITE_KEY=

# Optional: WhatsApp number for "Enquire on WhatsApp" buttons (10-digit Indian mobile, or with country code).
VITE_WHATSAPP_NUMBER=
